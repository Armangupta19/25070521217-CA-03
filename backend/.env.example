# SportSync Backend Configuration
PORT=5000

# MongoDB Connection String (Local MongoDB or MongoDB Atlas)
# Local:
MONGODB_URI=mongodb://127.0.0.1:27017/sportsync

# MongoDB Atlas (Cloud) Example:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sportsync?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=sportsync_jwt_super_secret_key_2025_prod_safe

# Allowed frontend origins (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Application Environment (development | production)
NODE_ENV=development
